model Notification {
  id        String    @id @default(uuid())
  userId    String
  type      String
  title     String
  body      String?
  taskId    String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User  @relation(fields: [userId], references: [id])
  task Task? @relation(fields: [taskId], references: [id])

  @@index([userId, readAt])
  @@map("notifications")
}
