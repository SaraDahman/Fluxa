{
  "name": "fluxa",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter client --filter server dev",
    "dev:docker": "docker compose up --build",
    "dev:docker:down": "docker compose down",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "pnpm -r type-check",
    "prepare": "husky",
    "db:deploy": "pnpm --filter server db:deploy",
    "db:generate": "pnpm --filter server db:generate"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6"
  },
  "pnpm": {
    "overrides": {
      "typescript": "^6.0.2"
    }
  },
  "lint-staged": {
    "**/*": "pnpm -r --parallel lint-staged"
  }
}
